<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Douyin Liquid Glass"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".status.ModuleStatusActivity"
            android:exported="true"
            android:theme="@style/Theme.LiquidSettings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".settings.ModuleSettingsProvider"
            android:authorities="com.autumn.douyin.liquidglass.settings"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.autumn.douyin.liquidglass.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_file_paths" />
        </provider>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Replace the Douyin native bottom bar with a liquid glass bar" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
